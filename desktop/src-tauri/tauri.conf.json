{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stocks IDX",
  "version": "0.1.0",
  "identifier": "id.mqdd.stocksidx",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Stocks IDX", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 700 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8200; frame-src 'self' http://127.0.0.1:8200; img-src 'self' data: https: http://127.0.0.1:8200; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "msi"],
    "resources": ["resources/frontend", "resources/backend"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}