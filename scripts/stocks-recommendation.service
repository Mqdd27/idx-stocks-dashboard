[Unit]
Description=Stocks Dashboard Daily Recommendation Worker
After=network.target stocks-backend.service

[Service]
Type=oneshot
User=stocks
Group=stocks
WorkingDirectory=/opt/stocks-dashboard
EnvironmentFile=/etc/stocks-dashboard/backend.env
Environment=PYTHONPATH=/opt/stocks-dashboard/backend:/opt/stocks-dashboard
ExecStart=/opt/stocks-dashboard/backend/venv/bin/python /opt/stocks-dashboard/scripts/recommendation_worker.py
StandardOutput=append:/opt/stocks-dashboard/logs/recommendations.log
StandardError=append:/opt/stocks-dashboard/logs/recommendations.log
